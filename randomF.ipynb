     "text": [
      "['apple' 'orange' 'orange' 'watermelon' 'watermelon']\n"
     ]
    }
   ],
    "from sklearn import tree\n",
    "features = [\n",
    "    [150, 0],  # Apple\n",
    "    [170, 0],  # Apple\n",
    "    [130, 1],  # Orange\n",
    "    [120, 1],  # Orange\n",
    "    [250,2],[190,2],[230,2]\n",
    "]\n",
    "labels = [\"apple\", \"apple\", \"orange\", \"orange\",\"orange\",\"watermelon\",\"watermelon\"]\n",
    "clf = tree.DecisionTreeClassifier()\n",
    "clf = clf.fit(features, labels)\n",
    "predict = clf.predict([[160, 0],[30,1],[150,1],[170,2],[100,2]])\n",
    "print(predict)"
   ]
